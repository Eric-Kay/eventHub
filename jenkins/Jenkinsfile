pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  parameters {
    choice(name: 'ACTION', choices: ['test', 'deploy'], description: 'Run tests or deploy')
  }

  environment {
    AWS_REGION = 'us-east-1'
    AWS_ACCOUNT_ID = '603108265570'
    ECR_REGISTRY = '603108265570.dkr.ecr.us-east-1.amazonaws.com'
    ECR_NAMESPACE = 'dev'
    COMPOSE = 'docker compose -f docker-compose.yaml -f docker-compose.ci.yaml'
    KUBECONFIG = '/var/jenkins_home/.kube/config'
    SONAR_HOST_URL = 'http://sonarqube:9000'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Create CI Env File') {
      steps {
        sh '''
          cat > .env <<'EOF'
POSTGRES_DB=eventhub
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhubpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
EOF
        '''
      }
    }

    stage('Create CI Compose Override') {
      steps {
        sh '''
          cat > docker-compose.ci.yaml <<'EOF'
services:
  postgres:
    ports: !reset []
  redis:
    ports: !reset []
  rabbitmq:
    ports: !reset []
EOF
        '''
      }
    }

    stage('Clean Existing Local Stack') {
      steps {
        sh '''
          set -eux
          ${COMPOSE} down -v --remove-orphans || true
        '''
      }
    }

    stage('Build Local Stack') {
      steps {
        sh '''
          set -eux
          ${COMPOSE} build
          ${COMPOSE} up -d postgres redis rabbitmq
          sleep 15
        '''
      }
    }

    stage('Pytest') {
      steps {
        sh '''
          set -eux
          ${COMPOSE} run --rm auth-service pytest -q tests
          ${COMPOSE} run --rm event-service pytest -q tests
          ${COMPOSE} run --rm booking-service pytest -q tests
        '''
      }
    }

    stage('Checkov IaC Scan') {
      steps {
        sh '''
          set -eux
          rm -rf checkov-report
          mkdir -p checkov-report

          docker run --rm \
            -v "$PWD:/repo" \
            bridgecrew/checkov:latest \
            -d /repo \
            --framework terraform,kubernetes,helm \
            --soft-fail \
            --output cli \
            --output junitxml \
            --output-file-path /repo/checkov-report
        '''
      }
      post {
        always {
          archiveArtifacts artifacts: 'checkov-report/**', allowEmptyArchive: true
        }
      }
    }

    stage('SonarQube Code Scan') {
      steps {
        withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
          sh '''
            set -eux

            docker run --rm \
              --network jenkins-net \
              -e SONAR_HOST_URL=http://sonarqube:9000 \
              -e SONAR_TOKEN=$SONAR_TOKEN \
              -v "$PWD:/usr/src" \
              sonarsource/sonar-scanner-cli:latest \
              -Dsonar.projectKey=eventhub \
              -Dsonar.projectName=EventHub \
              -Dsonar.sources=. \
              -Dsonar.exclusions=**/node_modules/**,**/.terraform/**,**/charts/**,**/Chart.lock,**/trivy-report/**,**/checkov-report/**
          '''
        }
      }
    }

    stage('Trivy Filesystem Scan') {
      steps {
        sh '''
          set -eux
          rm -rf trivy-report
          mkdir -p trivy-report

          docker run --rm \
            -v "$PWD:/src" \
            -v "$PWD/trivy-report:/report" \
            aquasec/trivy:latest fs \
            --scanners vuln,secret,misconfig \
            --severity HIGH,CRITICAL \
            --format table \
            --output /report/trivy-fs-report.txt \
            --exit-code 0 \
            /src

          test -f trivy-report/trivy-fs-report.txt || \
          echo "No Trivy issues found or no supported files detected." > trivy-report/trivy-fs-report.txt

          ls -la trivy-report
        '''
      }
      post {
        always {
          archiveArtifacts artifacts: 'trivy-report/**', allowEmptyArchive: true
        }
      }
    }

    stage('Login to ECR') {
      when {
        expression { params.ACTION == 'deploy' }
      }
      steps {
        withCredentials([
          string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY_ID'),
          string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
        ]) {
          sh '''
            set -eux
            aws sts get-caller-identity
            aws ecr get-login-password --region ${AWS_REGION} | \
              docker login --username AWS --password-stdin ${ECR_REGISTRY}
          '''
        }
      }
    }

    stage('Build and Push Images') {
      when {
        expression { params.ACTION == 'deploy' }
      }
      steps {
        sh '''
          set -eux

          for service in analytics-service auth-service booking-service event-service notification-service payment-service ticket-service; do
            docker build -t ${ECR_REGISTRY}/${ECR_NAMESPACE}/${service}:latest apps/${service}
            docker push ${ECR_REGISTRY}/${ECR_NAMESPACE}/${service}:latest
          done

          docker build -t ${ECR_REGISTRY}/${ECR_NAMESPACE}/frontend:latest apps/frontend
          docker push ${ECR_REGISTRY}/${ECR_NAMESPACE}/frontend:latest
        '''
      }
    }

    stage('Trivy Image Scan') {
      when {
        expression { params.ACTION == 'deploy' }
      }
      steps {
        sh '''
          set -eux
          mkdir -p trivy-report

          for service in analytics-service auth-service booking-service event-service notification-service payment-service ticket-service frontend; do
            docker run --rm \
              -v /var/run/docker.sock:/var/run/docker.sock \
              -v "$PWD/trivy-report:/report" \
              aquasec/trivy:latest image \
              --severity HIGH,CRITICAL \
              --format table \
              --output /report/trivy-image-${service}.txt \
              --exit-code 0 \
              ${ECR_REGISTRY}/${ECR_NAMESPACE}/${service}:latest
          done
        '''
      }
      post {
        always {
          archiveArtifacts artifacts: 'trivy-report/**', allowEmptyArchive: true
        }
      }
    }

    stage('Trigger ArgoCD Sync') {
      when {
        expression { params.ACTION == 'deploy' }
      }
      steps {
        withCredentials([
          string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY_ID'),
          string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
        ]) {
          sh '''
            set -eux
            aws sts get-caller-identity

            kubectl annotate application eventhub-dev -n argocd \
              argocd.argoproj.io/refresh=hard --overwrite

            kubectl patch application eventhub-dev -n argocd \
              --type merge \
              -p '{"operation":{"sync":{"revision":"HEAD","prune":true}}}' || true
          '''
        }
      }
    }

    stage('Verify Deployment') {
      when {
        expression { params.ACTION == 'deploy' }
      }
      steps {
        withCredentials([
          string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY_ID'),
          string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
        ]) {
          sh '''
            set -eux
            kubectl get applications -n argocd
            kubectl get pods -n eventhub
            kubectl get ingress -n eventhub
          '''
        }
      }
    }
  }

  post {
    always {
      sh '''
        ${COMPOSE} down -v --remove-orphans || true
      '''
    }
  }
}