pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  parameters {
    choice(name: 'ACTION', choices: ['test', 'deploy'], description: 'Run tests or deploy')
  }

  environment {
    AWS_REGION = 'us-east-1'
    AWS_ACCOUNT_ID = '603108265570'
    ECR_REGISTRY = '603108265570.dkr.ecr.us-east-1.amazonaws.com'
    ECR_NAMESPACE = 'dev'
    IMAGE_TAG = "${BUILD_NUMBER}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Create CI Env File') {
      steps {
        sh '''
          cat > .env <<'EOF'
POSTGRES_DB=eventhub
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhubpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
EOF
        '''
      }
    }

    stage('Build Local Stack') {
      steps {
        sh '''
          set -eux
          docker compose build
          docker compose up -d postgres redis rabbitmq
        '''
      }
    }

    stage('Service Tests') {
      steps {
        sh '''
          set -eux
          docker compose run --rm auth-service pytest -q
          docker compose run --rm event-service pytest -q
          docker compose run --rm booking-service pytest -q
        '''
      }
    }

    stage('Login to ECR') {
      when {
        expression { params.ACTION == 'deploy' }
      }
      steps {
        sh '''
          set -eux
          aws ecr get-login-password --region ${AWS_REGION} | \
            docker login --username AWS --password-stdin ${ECR_REGISTRY}
        '''
      }
    }

    stage('Build and Push Images') {
      when {
        expression { params.ACTION == 'deploy' }
      }
      steps {
        sh '''
          set -eux

          for service in analytics-service auth-service booking-service event-service notification-service payment-service ticket-service; do
            docker build -t ${ECR_REGISTRY}/${ECR_NAMESPACE}/${service}:latest apps/${service}
            docker push ${ECR_REGISTRY}/${ECR_NAMESPACE}/${service}:latest
          done

          docker build -t ${ECR_REGISTRY}/${ECR_NAMESPACE}/frontend:latest apps/frontend
          docker push ${ECR_REGISTRY}/${ECR_NAMESPACE}/frontend:latest
        '''
      }
    }

    stage('Trigger ArgoCD Sync') {
      when {
        expression { params.ACTION == 'deploy' }
      }
      steps {
        sh '''
          set -eux

          kubectl annotate application eventhub-dev -n argocd \
            argocd.argoproj.io/refresh=hard --overwrite

          kubectl patch application eventhub-dev -n argocd \
            --type merge \
            -p '{"operation":{"sync":{"revision":"HEAD","prune":true}}}' || true
        '''
      }
    }

    stage('Verify Deployment') {
      when {
        expression { params.ACTION == 'deploy' }
      }
      steps {
        sh '''
          set -eux

          kubectl get applications -n argocd
          kubectl get pods -n eventhub
          kubectl get ingress -n eventhub
        '''
      }
    }
  }

  post {
    always {
      sh 'docker compose down -v || true'
    }
  }
}